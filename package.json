{
  "name": "astra",
  "version": "0.1.0",
  "bin": {
    "astra": "bin/astra.js"
  },
  "scripts": {
    "clean": "rm -rf dist cdk.out node_modules",
    "build": "tsc --project tsconfig.json",
    "watch": "tsc -w --project tsconfig.json",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "npm run build && cdk synth && cdk deploy --all --require-approval never"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "aws-cdk": "2.1031.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.215.0",
    "constructs": "^10.0.0"
  }
}
